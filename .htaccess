<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Se existir a pasta dist e o arquivo requisitado estiver dentro dela, servir de dist/
  RewriteCond %{DOCUMENT_ROOT}/dist/$1 -f [OR]
  RewriteCond %{DOCUMENT_ROOT}/dist/$1 -d
  RewriteRule ^(.*)$ dist/$1 [L]

  # Se dist/index.html existir, servir como fallback de SPA
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{DOCUMENT_ROOT}/dist/index.html -f
  RewriteRule . dist/index.html [L]

  # Fallback padrão para index.html na raiz
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . index.html [L]
</IfModule>
